# ─────────────────────────────────────────────────────────────────────────────
# NoteWise — Server Environment Variables
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set for that feature to work.
# Variables marked [OPTIONAL] can be left blank to use defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM ─────────────────────────────────────────────────────────────────

# [RECOMMENDED] Manus Forge API key — proxies requests to Gemini 2.5 Flash.
# Used by the server for all AI chat and code-generation features.
# If left blank the server falls back to using GEMINI_API_KEY (see below),
# or the user can supply their own key from the app's Settings screen.
BUILT_IN_FORGE_API_KEY=

# [OPTIONAL] Override the Forge API endpoint (defaults to https://forge.manus.im).
BUILT_IN_FORGE_API_URL=

# [OPTIONAL] Direct Google Gemini API key.
# This documents the format expected when a user enters their key in the
# app's Settings screen ("Gemini API Key" field). The mobile app forwards
# it to the backend as the X-Gemini-API-Key header, which the server uses
# instead of BUILT_IN_FORGE_API_KEY when present.
GEMINI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────

# [OPTIONAL] MySQL-compatible connection string.
# When absent the app runs entirely in-memory (data is lost on restart).
# Example: mysql://user:password@host:3306/notewise
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────────

# [REQUIRED for OAuth login] Secret used to sign session JWTs.
JWT_SECRET=

# [OPTIONAL] Manus OAuth portal URL (leave blank to disable Manus OAuth).
OAUTH_SERVER_URL=

# ── App Identity ──────────────────────────────────────────────────────────────

# [OPTIONAL] Internal app ID used by the Manus platform.
VITE_APP_ID=

# [OPTIONAL] Deep-link / OAuth callback base URL exposed to the frontend.
EXPO_PUBLIC_API_BASE_URL=
