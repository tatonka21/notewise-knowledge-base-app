# Gemini API Key (get from https://aistudio.google.com/app/apikey)
# Use this if you want to call the Gemini API directly (not via Forge proxy).
# Currently the app routes LLM calls through BUILT_IN_FORGE_API_KEY via the Forge proxy.
GEMINI_API_KEY=

# Forge API URL (optional, defaults to https://forge.manus.im)
# The Forge proxy routes requests to Gemini 2.5 Flash under the hood.
BUILT_IN_FORGE_API_URL=

# Forge API Key (required for all AI features — chat, app generation, website generation)
# This authenticates requests to the Forge proxy which uses Gemini 2.5 Flash.
BUILT_IN_FORGE_API_KEY=

# JWT Secret for signing session cookies (use a strong random string)
JWT_SECRET=

# MySQL/TiDB Database URL (optional - in-memory/local store used if not set)
# Format: mysql://user:password@host:port/database
DATABASE_URL=

# OAuth Server URL (required for authentication)
OAUTH_SERVER_URL=

# Owner OpenID (this user gets the admin role automatically)
OWNER_OPEN_ID=

# App ID (used for OAuth callback)
VITE_APP_ID=
